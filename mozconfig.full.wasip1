# Gecko software renderer on WASI preview1 + wasi-threads.
# This port is separate from the Emscripten build; no JS glue is linked.
mk_add_options MOZ_OBJDIR=$topsrcdir/../obj-full-wasip1
ac_add_options --enable-application=browser
ac_add_options --target=wasm32-unknown-wasi
ac_add_options --enable-default-toolkit=cairo-headless
ac_add_options --disable-jit
ac_add_options --enable-portable-baseline-interp
ac_add_options --enable-portable-baseline-interp-force
ac_add_options --disable-shared-memory
ac_add_options --disable-tests
ac_add_options --disable-debug
ac_add_options --enable-optimize=-O2
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-backgroundtasks
ac_add_options --disable-webrtc
ac_add_options --without-wasm-sandboxed-libraries
ac_add_options --disable-ctypes
ac_add_options --disable-bootstrap
# bindgen must parse wasi-sdk's libc++ with the same LLVM.
ac_add_options --with-libclang-path=${LIBCLANG_PATH:-$WASI_SDK_PATH/lib}
export CC="$WASI_SDK_PATH/bin/clang --target=wasm32-wasip1-threads"
export CXX="$WASI_SDK_PATH/bin/clang++ --target=wasm32-wasip1-threads"
export AR="$WASI_SDK_PATH/bin/llvm-ar"
export RANLIB="$WASI_SDK_PATH/bin/llvm-ranlib"
# setjmp/longjmp use the legacy wasm exception instructions, as BrowserOS's
# clang.wasm does. The emulated mman/signal/clock libraries are where wasi-libc
# keeps those POSIX functions; BrowserOS's libc fills the signal and clock ones.
WASI_EMULATION="-D_WASI_EMULATED_MMAN -D_WASI_EMULATED_SIGNAL -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_GETPID"
WASI_SJLJ="-mllvm -wasm-enable-sjlj -mllvm -wasm-use-legacy-eh"
export CFLAGS="--sysroot=$BROWSEROS_SYSROOT -pthread -msimd128 $WASI_EMULATION $WASI_SJLJ -I$topsrcdir/modules/freetype2/include"
export CXXFLAGS="$CFLAGS"
export BINDGEN_CFLAGS="--sysroot=$BROWSEROS_SYSROOT $WASI_EMULATION"
export LDFLAGS="--sysroot=$BROWSEROS_SYSROOT -pthread -lsetjmp -lwasi-emulated-mman -lwasi-emulated-signal -lwasi-emulated-process-clocks -lwasi-emulated-getpid"
export RUSTFLAGS="-Ctarget-feature=+simd128,+atomics,+bulk-memory"
HOST_CC=clang
HOST_CXX=clang++
export LLVM_OBJDUMP="$WASI_SDK_PATH/bin/llvm-objdump"
