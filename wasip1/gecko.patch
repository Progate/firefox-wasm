diff --git a/xpcom/reflect/xptinfo/xptcall_wasi.h b/xpcom/reflect/xptinfo/xptcall_wasi.h
new file mode 100644
index 0000000000..6bba9adad9
--- /dev/null
+++ b/xpcom/reflect/xptinfo/xptcall_wasi.h
@@ -0,0 +1,44 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Tables generated by xptcodegen.py for xptcall on wasm32-wasi. A signature is
+// "ii" (nsresult return, this) followed by one character per C++ argument:
+// i = i32, j = i64, f = f32, d = f64. Arguments are passed in 8-byte slots.
+
+#ifndef xptcall_wasi_h
+#define xptcall_wasi_h
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "nsError.h"
+
+extern "C" nsresult WasmXPTCStubDispatch(void* aSelf, uint32_t aMethodIndex,
+                                         uint8_t* aArgs, uint32_t aCount);
+
+namespace xptcall_wasi {
+
+typedef nsresult (*Invoker)(void* aFunc, void* aThis, const uint8_t* aArgs);
+
+struct InvokeEntry {
+  const char* mSig;
+  Invoker mInvoke;
+};
+
+struct StubEntry {
+  const char* mSig;
+  uint16_t mMethodIndex;
+  void* mFunc;
+};
+
+// Sorted by signature.
+extern const InvokeEntry kInvokers[];
+extern const size_t kInvokerCount;
+// Sorted by (signature, method index).
+extern const StubEntry kStubs[];
+extern const size_t kStubCount;
+
+}  // namespace xptcall_wasi
+
+#endif  // xptcall_wasi_h
diff --git a/xpcom/reflect/xptinfo/xptcodegen.py b/xpcom/reflect/xptinfo/xptcodegen.py
index d089e84807..b9d46fb458 100644
--- a/xpcom/reflect/xptinfo/xptcodegen.py
+++ b/xpcom/reflect/xptinfo/xptcodegen.py
@@ -588,6 +588,162 @@ const uint16_t sInterfacesSize = std::size(sInterfaces);
 """
     )
 
+    write_wasi_xptcall(interfaces, ancestors, fd)
+
+
+# wasm call_indirect checks the exact function type, so xptcall cannot use one
+# assembly trampoline for every method on WASI. Emit a C++ function for every
+# signature used by the interfaces (invoke) and for every (signature, method
+# index) a JS-implemented interface can be called through (stubs).
+WASI_ARITHMETIC_SIG = {
+    "TD_INT64": "j",
+    "TD_UINT64": "j",
+    "TD_FLOAT": "f",
+    "TD_DOUBLE": "d",
+}
+WASI_ARITHMETIC_TAGS = {
+    "TD_INT8",
+    "TD_INT16",
+    "TD_INT32",
+    "TD_INT64",
+    "TD_UINT8",
+    "TD_UINT16",
+    "TD_UINT32",
+    "TD_UINT64",
+    "TD_FLOAT",
+    "TD_DOUBLE",
+    "TD_BOOL",
+    "TD_CHAR",
+    "TD_WCHAR",
+}
+WASI_CTYPE = {"i": "int32_t", "j": "int64_t", "f": "float", "d": "double"}
+
+
+def wasi_method_sig(method):
+    """Return the wasm signature of the C++ method (nsresult, this, args...),
+    matching WasmComputeSig in xptcall/md/unix/xptcstubs_wasi.cpp."""
+
+    def param_char(param):
+        if "out" in param["flags"]:
+            return "i"
+        tag = param["type"]["tag"]
+        if tag not in WASI_ARITHMETIC_TAGS:
+            return "i"
+        return WASI_ARITHMETIC_SIG.get(tag, "i")
+
+    flags = method["flags"]
+    params = method["params"]
+    sig = "ii"
+    context = None
+    if "jscontext" in flags:
+        if "getter" in flags or "setter" in flags:
+            context = 0
+        else:
+            context = len(params) - (1 if "hasretval" in flags else 0)
+    for i, param in enumerate(params):
+        if i == context:
+            sig += "i"
+        sig += param_char(param)
+    if context is not None and context == len(params):
+        sig += "i"
+    if "optargc" in flags:
+        sig += "i"
+    return sig
+
+
+def write_wasi_xptcall(interfaces, ancestors, fd):
+    invoke_sigs = set()
+    stubs = set()
+    for iface in interfaces:
+        chain = list(ancestors(iface))
+        chain.reverse()
+        methods = [m for i in chain for m in i["methods"]]
+        builtinclass = "builtinclass" in iface["flags"]
+        for index, method in enumerate(methods):
+            if "notxpcom" in method["flags"]:
+                continue
+            sig = wasi_method_sig(method)
+            if "hidden" not in method["flags"]:
+                invoke_sigs.add(sig)
+            if not builtinclass and index >= 3:
+                stubs.add((sig, index))
+
+    def args(sig):
+        return [WASI_CTYPE[c] for c in sig[2:]]
+
+    fd.write(
+        """
+#if defined(__wasi__)
+#include <string.h>
+#include "xptcall_wasi.h"
+
+namespace xptcall_wasi {
+
+"""
+    )
+    invokers = sorted(invoke_sigs)
+    for sig in invokers:
+        types = args(sig)
+        loads = []
+        for n, ty in enumerate(types):
+            loads.append(
+                "%s a%d; memcpy(&a%d, aArgs + %d, sizeof(a%d));" % (ty, n, n, n * 8, n)
+            )
+        fd.write(
+            "static nsresult Invoke_%s(void* aFunc, void* aThis, const uint8_t* aArgs) {\n"
+            "  %s\n"
+            "  return reinterpret_cast<nsresult (*)(void*%s)>(aFunc)(aThis%s);\n"
+            "}\n"
+            % (
+                sig,
+                "\n  ".join(loads) if loads else "(void)aArgs;",
+                "".join(", " + t for t in types),
+                "".join(", a%d" % n for n in range(len(types))),
+            )
+        )
+    fd.write("\nconst InvokeEntry kInvokers[] = {\n")
+    for sig in invokers:
+        fd.write('  {"%s", Invoke_%s},\n' % (sig, sig))
+    fd.write("};\nconst size_t kInvokerCount = std::size(kInvokers);\n\n")
+
+    stub_list = sorted(stubs)
+    for sig, index in stub_list:
+        types = args(sig)
+        stores = [
+            "memcpy(buf + %d, &a%d, sizeof(a%d));" % (n * 8, n, n)
+            for n in range(len(types))
+        ]
+        fd.write(
+            "static nsresult Stub_%s_%d(void* aSelf%s) {\n"
+            "  uint8_t buf[%d] = {};\n"
+            "  %s\n"
+            "  return WasmXPTCStubDispatch(aSelf, %d, buf, %d);\n"
+            "}\n"
+            % (
+                sig,
+                index,
+                "".join(", %s a%d" % (t, n) for n, t in enumerate(types)),
+                max(len(types), 1) * 8,
+                "\n  ".join(stores),
+                index,
+                len(types),
+            )
+        )
+    fd.write("\nconst StubEntry kStubs[] = {\n")
+    for sig, index in stub_list:
+        fd.write(
+            '  {"%s", %d, reinterpret_cast<void*>(Stub_%s_%d)},\n'
+            % (sig, index, sig, index)
+        )
+    fd.write(
+        """};
+const size_t kStubCount = std::size(kStubs);
+
+}  // namespace xptcall_wasi
+#endif  // __wasi__
+"""
+    )
+
 
 def link_and_write(files, outfile, outheader):
     interfaces = []
