+#ifdef MOZ_WIDGET_HEADLESS
+void gfxFT2FontList::FindFontsInTree(const nsCString& aDir,
+                                     FontNameCache* aFNC, int aDepth) {
+  FindFontsInDir(aDir, aFNC);
+  if (aDepth <= 0) {
+    return;
+  }
+  DIR* d = opendir(aDir.get());
+  if (!d) {
+    return;
+  }
+  struct dirent* ent = nullptr;
+  while ((ent = readdir(d)) != nullptr) {
+    if (ent->d_name[0] == '.') {
+      continue;
+    }
+    nsAutoCString path(aDir);
+    path.Append('/');
+    path.Append(ent->d_name);
+    struct stat info;
+    if (stat(path.get(), &info) == 0 && S_ISDIR(info.st_mode)) {
+      FindFontsInTree(path, aFNC, aDepth - 1);
+    }
+  }
+  closedir(d);
+}
+#endif
