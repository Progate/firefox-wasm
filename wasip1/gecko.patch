+#    elif defined(__wasi__)
+/* WASI has no sendfile(); copy through a buffer with Linux's semantics: read
+ * from *offset (leaving the file position alone) and advance it by what was
+ * written. */
+#      include <sys/types.h>
+#      include <unistd.h>
+static ssize_t sendfile(int out_fd, int in_fd, off_t* offset, size_t count) {
+  char buf[65536];
+  off_t pos = offset ? *offset : lseek(in_fd, 0, SEEK_CUR);
+  ssize_t n;
+  ssize_t written;
+  if (count > sizeof(buf)) {
+    count = sizeof(buf);
+  }
+  n = pread(in_fd, buf, count, pos);
+  if (n <= 0) {
+    return n;
+  }
+  written = write(out_fd, buf, n);
+  if (written <= 0) {
+    return written;
+  }
+  if (offset) {
+    *offset = pos + written;
+  } else {
+    lseek(in_fd, pos + written, SEEK_SET);
+  }
+  return written;
+}
