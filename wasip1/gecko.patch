diff --git a/xpcom/reflect/xptcall/md/unix/xptcinvoke_wasi.cpp b/xpcom/reflect/xptcall/md/unix/xptcinvoke_wasi.cpp
new file mode 100644
index 0000000000..35ae8d985a
--- /dev/null
+++ b/xpcom/reflect/xptcall/md/unix/xptcinvoke_wasi.cpp
@@ -0,0 +1,107 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// wasm32-wasi xptcall, JS->C++ direction: NS_InvokeByIndex.
+//
+// wasm call_indirect needs the exact function type at the call site. The
+// arguments are packed into 8-byte slots, and the call is made by the invoker
+// that xptcodegen.py generated for this signature.
+
+#include "xptcprivate.h"
+#include "xptcall_wasi.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+static const xptcall_wasi::InvokeEntry* FindInvoker(const char* aSig) {
+  size_t lo = 0;
+  size_t hi = xptcall_wasi::kInvokerCount;
+  while (lo < hi) {
+    size_t mid = (lo + hi) / 2;
+    int cmp = strcmp(xptcall_wasi::kInvokers[mid].mSig, aSig);
+    if (cmp == 0) {
+      return &xptcall_wasi::kInvokers[mid];
+    }
+    if (cmp < 0) {
+      lo = mid + 1;
+    } else {
+      hi = mid;
+    }
+  }
+  return nullptr;
+}
+
+extern "C" nsresult NS_InvokeByIndex(nsISupports* that, uint32_t methodIndex,
+                                     uint32_t paramCount,
+                                     nsXPTCVariant* params) {
+  void** vtable = *reinterpret_cast<void***>(that);
+  void* fp = vtable[methodIndex];
+
+  char sig[PARAM_BUFFER_COUNT + 8];
+  size_t sn = 0;
+  sig[sn++] = 'i';  // nsresult
+  sig[sn++] = 'i';  // this
+  uint8_t argbuf[PARAM_BUFFER_COUNT * 8];
+  if (paramCount > PARAM_BUFFER_COUNT) {
+    return NS_ERROR_ILLEGAL_VALUE;
+  }
+
+  for (uint32_t i = 0; i < paramCount; i++) {
+    nsXPTCVariant& s = params[i];
+    uint8_t* a = argbuf + size_t(i) * 8;
+    memset(a, 0, 8);
+    if (s.IsIndirect()) {
+      sig[sn++] = 'i';
+      void* p = &s.val;
+      memcpy(a, &p, sizeof(p));
+      continue;
+    }
+    int32_t i32 = 0;
+    switch (s.type) {
+      case nsXPTType::T_DOUBLE:
+        sig[sn++] = 'd';
+        memcpy(a, &s.val.d, sizeof(double));
+        continue;
+      case nsXPTType::T_FLOAT:
+        sig[sn++] = 'f';
+        memcpy(a, &s.val.f, sizeof(float));
+        continue;
+      case nsXPTType::T_I64:
+        sig[sn++] = 'j';
+        memcpy(a, &s.val.i64, sizeof(int64_t));
+        continue;
+      case nsXPTType::T_U64:
+        sig[sn++] = 'j';
+        memcpy(a, &s.val.u64, sizeof(uint64_t));
+        continue;
+      case nsXPTType::T_I8: i32 = s.val.i8; break;
+      case nsXPTType::T_I16: i32 = s.val.i16; break;
+      case nsXPTType::T_I32: i32 = s.val.i32; break;
+      case nsXPTType::T_U8: i32 = s.val.u8; break;
+      case nsXPTType::T_U16: i32 = s.val.u16; break;
+      case nsXPTType::T_U32: i32 = int32_t(s.val.u32); break;
+      case nsXPTType::T_BOOL: i32 = s.val.b ? 1 : 0; break;
+      case nsXPTType::T_CHAR: i32 = s.val.c; break;
+      case nsXPTType::T_WCHAR: i32 = s.val.wc; break;
+      default:
+        i32 = int32_t(reinterpret_cast<intptr_t>(s.val.p));
+        break;
+    }
+    sig[sn++] = 'i';
+    memcpy(a, &i32, sizeof(i32));
+  }
+  sig[sn] = '\0';
+
+  const xptcall_wasi::InvokeEntry* entry = FindInvoker(sig);
+  if (!entry) {
+    // Every signature reachable from XPIDL is generated; reaching this means
+    // the generator and the caller disagree about the C++ ABI.
+    fprintf(stderr, "xptcall: no invoker for signature %s (method %u)\n", sig,
+            methodIndex);
+    abort();
+  }
+  return entry->mInvoke(fp, that, argbuf);
+}
