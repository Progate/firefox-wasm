diff --git a/third_party/rust/libc-0.2.178/src/wasi/browseros.rs b/third_party/rust/libc-0.2.178/src/wasi/browseros.rs
new file mode 100644
index 0000000..107a3f3
--- /dev/null
+++ b/third_party/rust/libc-0.2.178/src/wasi/browseros.rs
@@ -0,0 +1,30 @@
+//! POSIX functions that BrowserOS's libc (a wasi-libc fork) provides on
+//! wasm32-wasip1 beyond plain wasi-libc. BrowserOS's libc uses the riscv32
+//! Linux values for its constants and structs (errno, O_*, AF_*, struct stat,
+//! ...), and this module's `mod.rs` and `p2.rs` carry the same values.
+
+use crate::prelude::*;
+
+pub const PATH_MAX: c_int = 4096;
+
+pub const AF_UNIX: c_int = 1;
+pub const SOCK_CLOEXEC: c_int = 0o2000000;
+pub const MSG_DONTWAIT: c_int = 0x0040;
+
+pub const SIGINT: c_int = 2;
+pub const SIGABRT: c_int = 6;
+pub const SIGKILL: c_int = 9;
+pub const SIGTERM: c_int = 15;
+
+use crate::pid_t;
+
+extern "C" {
+    pub fn getpid() -> pid_t;
+    pub fn getppid() -> pid_t;
+    pub fn kill(pid: pid_t, sig: c_int) -> c_int;
+    pub fn pipe(fds: *mut c_int) -> c_int;
+    pub fn pipe2(fds: *mut c_int, flags: c_int) -> c_int;
+    pub fn dup(fd: c_int) -> c_int;
+    pub fn dup2(src: c_int, dst: c_int) -> c_int;
+    pub fn socketpair(domain: c_int, type_: c_int, protocol: c_int, sv: *mut c_int) -> c_int;
+}
